# Contact form delivery
# Create a server-only API key after verifying encomm.ai with Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ENCOMM Website <website@encomm.ai>
CONTACT_TO_EMAIL=info@encomm.ai

# Optional comma-separated origins if the form is submitted from an additional
# preview domain. Same-origin requests are accepted automatically.
CONTACT_ALLOWED_ORIGINS=
